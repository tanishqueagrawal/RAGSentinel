# Optional compatible LLM judge; leave blank to use the free heuristic mode.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional target RAG endpoint for actual retriever/generator diagnosis.
RAG_ENDPOINT_URL=
RAG_ENDPOINT_API_KEY=
# JSON object; {{question}} is replaced with the incoming question.
RAG_REQUEST_TEMPLATE={"question": "{{question}}"}
